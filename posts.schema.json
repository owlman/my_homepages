{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["title", "url", "date"],
    "properties": {
      "title": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri" },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    },
    "additionalProperties": false
  }
}
